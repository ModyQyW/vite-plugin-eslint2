# Rspress fingerprints every file under /static, so a URL's content never
# changes. Without this, Cloudflare Pages serves them as `max-age=0` and every
# repeat visit revalidates the whole bundle.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# The Markdown mirrors and the llms files repeat what the HTML pages already
# say. Agents keep fetching them; search engines should index the HTML page
# instead of its duplicate.
/*.md
  X-Robots-Tag: noindex

/llms.txt
  X-Robots-Tag: noindex

/llms-full.txt
  X-Robots-Tag: noindex

/zh/llms.txt
  X-Robots-Tag: noindex

/zh/llms-full.txt
  X-Robots-Tag: noindex
